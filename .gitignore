# ==============================================================================
# RETAIL INVENTORY MANAGEMENT SYSTEM (RIMS) - .gitignore
# ==============================================================================

# Backend / Maven Build Artifacts
backend/target/
**/target/
*.class
*.jar
*.war
*.ear

# Frontend / Node Build Artifacts
frontend/node_modules/
**/node_modules/
frontend/dist/
**/dist/
frontend/.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Application & Runtime Logs
*.log
logs/
backend/logs/

# IDE / Editor Files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# OS Specific
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

.vercel
